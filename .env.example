DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hockey_st?schema=public"
# Secret Auth.js uses to encrypt the session cookie. Generate a local value and do not commit it.
AUTH_SECRET=
# Google OAuth client id. Google is not a role source.
AUTH_GOOGLE_ID=
# Google OAuth client secret.
AUTH_GOOGLE_SECRET=
# Public base URL Auth.js uses for callbacks, such as http://localhost:3005.
AUTH_URL=
# Read-write token for the private Vercel Blob store. Player photos are not public.
BLOB_READ_WRITE_TOKEN=
# Base64-encoded 32-byte key used to encrypt player DNI at rest (openssl rand -base64 32).
ENCRYPTION_KEY=
